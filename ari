import math

# 1. 이동 메커니즘을 가진 기본 챔피언 클래스
class Champion:
    def __init__(self, name, x, y, base_ms):
        self.name = name
        self.x = x
        self.y = y
        self.hp = 1000
        self.base_ms = base_ms          # 기본 이동속도
        self.bonus_flat_ms = 0          # 고정 추가 이동속도
        self.bonus_percent_ms = 0.0     # 비율 추가 이동속도
        
        self.state = "IDLE"             # IDLE, MOVING, DASHING, CHARMED
        self.target_pos = None          # 목표 좌표
        
    def get_current_ms(self):
        """이동 속도 공식 및 소프트 캡(Soft Cap) 적용"""
        raw_ms = (self.base_ms + self.bonus_flat_ms) * (1.0 + self.bonus_percent_ms)
        
        if raw_ms > 490:
            return 415 + (75 * 0.8) + ((raw_ms - 490) * 0.5)
        elif raw_ms > 415:
            return 415 + ((raw_ms - 415) * 0.8)
        return raw_ms

    def distance_to(self, target_x, target_y):
        return math.hypot(self.x - target_x, self.y - target_y)

    def update_position(self, delta_time):
        """프레임마다 챔피언의 위치를 업데이트"""
        if not self.target_pos or self.state not in ["MOVING", "CHARMED", "DASHING"]:
            return

        tx, ty = self.target_pos
        dist = self.distance_to(tx, ty)
        
        # 돌진(Dash) 상태라면 돌진 속도 적용
        speed = 1000 if self.state == "DASHING" else self.get_current_ms()
        step = speed * delta_time
        
        if dist <= step:
            self.x, self.y = tx, ty
            if self.state != "CHARMED":
                self.state = "IDLE"
        else:
            direction_x = (tx - self.x) / dist
            direction_y = (ty - self.y) / dist
            self.x += direction_x * step
            self.y += direction_y * step

    def apply_cc_charm(self, caster, duration):
        """매혹 CC기 적용"""
        self.state = "CHARMED"
        self.target_pos = (caster.x, caster.y)
        print(f"[{self.name}] 상태 이상: {duration}초 동안 {caster.name}에게 매혹됨!")

# 2. 아리 챔피언 클래스
class Ahri(Champion):
    def __init__(self, x, y):
        super().__init__("Ahri", x, y, base_ms=330)
        self.passive_stacks = 0
        self.r_dashes_left = 0
        
    def passive_essence_theft(self):
        self.passive_stacks += 1
        if self.passive_stacks >= 9:
            heal_amount = 90
            self.hp += heal_amount
            self.passive_stacks = 0
            print(f"[Ahri] 정기 흡수! 체력을 {heal_amount}만큼 회복합니다.")

    def cast_q_orb_of_deception(self, target_x, target_y):
        print(f"[Ahri] Q - 현혹의 구슬 시전! ({target_x}, {target_y}) 방향")

    def cast_w_fox_fire(self):
        self.bonus_percent_ms = 0.40
        print(f"[Ahri] W - 여우불 시전! 이동 속도가 40% 상승합니다.")

    def cast_e_charm(self, target_enemy):
        print(f"[Ahri] E - 매혹 적중! 대상: {target_enemy.name}")
        target_enemy.apply_cc_charm(caster=self, duration=1.5)

    def cast_r_spirit_rush(self, target_x, target_y):
        if self.r_dashes_left <= 0:
            print("[Ahri] 혼령 질풍 사용 횟수가 없습니다.")
            return
            
        self.r_dashes_left -= 1
        self.state = "DASHING"
        self.target_pos = (target_x, target_y)
        print(f"[Ahri] R - 혼령 질풍! ({target_x}, {target_y})로 돌진합니다. (남은 횟수: {self.r_dashes_left})")


# 3. 메인 실행 루프
if __name__ == "__main__":
    # 객체 생성
    ahri = Ahri(x=0, y=0)
    yasuo = Champion("Yasuo", x=500, y=500, base_ms=345)

    print("=== 스킬 시전 시작 ===")
    ahri.r_dashes_left = 3
    ahri.cast_r_spirit_rush(400, 400)  # 야스오 근처로 돌진
    ahri.cast_e_charm(yasuo)           # 야스오에게 매혹
    ahri.cast_q_orb_of_deception(500, 500)
    ahri.cast_w_fox_fire()

    print("\n=== 프레임 진행 시뮬레이션 ===")
    for frame in range(1, 6):
        delta_time = 0.1  # 0.1초 경과
        ahri.update_position(delta_time)
        yasuo.update_position(delta_time)
        
        print(f"[Frame {frame}] Ahri 위치: ({ahri.x:.1f}, {ahri.y:.1f}) | Yasuo 위치: ({yasuo.x:.1f}, {yasuo.y:.1f}) (상태: {yasuo.state})")
